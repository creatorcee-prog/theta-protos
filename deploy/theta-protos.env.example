# /etc/theta-protos.env: copy this, fill in what you use, then: sudo chmod 640 /etc/theta-protos.env
#                                                               sudo chown root:theta-protos /etc/theta-protos.env
# Empty lines are fine; a variable left empty counts as unset. Never commit the real file.

# ---- the server (app.py)
# The key the phone signs in with (header x-protos-key or the cookie from /api/login). Unset = no auth: dev only.
PROTOS_KEY=
# Set by theta-protos.service already; only change them here if you know why.
#PROTOS_DATA=/var/lib/theta-protos
#HOST=127.0.0.1
#PORT=8780
# Where the phone app's files are (default: web/ in the checkout).
#PROTOS_WEB=
# 0 turns off the built-in 5-minute proactive tick (Theta texting first).
#PROTOS_TICK=1
# 1 silences the per-request access log.
#PROTOS_QUIET=0
# Most tokens a reply may use.
#PROTOS_MAX_TOKENS=1200

# ---- models (models.py, router.py). At least one key, or a local model.
DEEPSEEK_API_KEY=
#DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=
#ANTHROPIC_QUICK_MODEL=
GEMINI_API_KEY=
#GEMINI_MODEL=
#GEMINI_THINK_MODEL=
GROQ_API_KEY=
#GROQ_MODEL=
#GROQ_THINK_MODEL=
# A local OpenAI-compatible server (Ollama: http://127.0.0.1:11434/v1).
#LOCAL_LLM_URL=
#LOCAL_LLM_MODEL=
#LOCAL_LLM_KEY=
# 1 = try the local model first for everything.
#PROTOS_LOCAL_FIRST=0
# 0 = never spend a model call on routing (heuristics only).
#PROTOS_CLASSIFIER=1
#PROTOS_LLM_TIMEOUT=90
# Web search for the "search" tier.
TAVILY_API_KEY=

# ---- persona (persona.py)
# Your time zone, used until you set one in the app's Settings (also for quiet hours and the 7:00/18:00 briefs).
PROTOS_TZ=America/Denver
#PROTOS_SOUL=/opt/theta-protos/persona/SOUL.md

# ---- phone notifications (push.py). Needs `pip install pywebpush` (see README).
# Leave both keys empty and a pair is made once and kept in the database. To reuse Theta's pair (so phones
# already signed up keep working after you move), copy theta-app's VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The contact push services see. Apple refuses pushes without a real-looking one.
VAPID_SUBJECT=mailto:you@example.com

# ---- Vantage (vantage.py). One of the two, or neither (then no Vantage texts and no briefs).
# Over HTTP: Theta's Vantage and Theta's dashboard key.
VANTAGE_URL=
VANTAGE_KEY=
# Or locally: a theta-app checkout's vantage/ folder, run in this process (wins over VANTAGE_URL).
#VANTAGE_DIR=/opt/theta-app/vantage
# Where local Vantage keeps its files (default $PROTOS_DATA/vantage).
#VANTAGE_DATA=
